# Copy to .env.local and fill in. NEVER commit real values.
#
# Public (inlined into the browser bundle by Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. The service-role key bypasses RLS: never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only HMAC pepper for duplicate identity detection. Rotating it
# invalidates existing digests, so treat it as durable key material.
KYC_HASH_PEPPER=

# KYC provider. "mock" is deterministic and stores nothing; real providers must
# be implemented before use. With auto-verify disabled, submissions queue for
# staff review in /admin/kyc (closest to the production path).
KYC_PROVIDER=mock
KYC_MOCK_AUTO_VERIFY=false

# Paystack (test mode). Live keys are refused unless ALLOW_LIVE_PAYMENTS=true in production.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Transactional email (optional). Without these, guarantor invitations are still
# created but are marked "not sent" and the borrower shares the link manually.
# Compatible with Resend: https://resend.com
RESEND_API_KEY=
EMAIL_FROM=1kDaily <notifications@your-domain.example>

# Shared secret for scheduled routes (Vercel Cron sends it as a bearer token).
CRON_SECRET=

