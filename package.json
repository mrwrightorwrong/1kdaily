{
  "name": "1kdaily",
  "version": "0.1.0",
  "private": true,
  "description": "1kDaily — Save Daily. Build Capacity. Unlock Opportunity.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22 <27"
  },
  "scripts": {
    "dev": "npm run dev --workspace @1kdaily/web",
    "build": "npm run build --workspace @1kdaily/web",
    "start": "npm run start --workspace @1kdaily/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "verify": "npm run typecheck && npm run test && npm run build",
    "qa": "node tools/qa/probe.mjs",
    "qa:mobile": "node tools/qa/mobile.mjs",
    "qa:sections": "node tools/qa/sections.mjs",
    "e2e": "node tools/qa/e2e-phase2.mjs",
    "e2e:phase3": "node tools/qa/e2e-phase3.mjs",
    "db:sql": "node tools/db/sql.mjs",
    "db:test": "node tools/db/rls-tests.mjs",
    "db:role": "node tools/db/grant-role.mjs",
    "secrets:setup": "node tools/setup/env-from-keys.mjs",
    "check:encoding": "node tools/check-encoding.mjs .",
    "check:identity": "node tools/check-identity-leak.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1"
  }
}
